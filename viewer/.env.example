# 복사해서 .env.local 로 쓰세요 (git 에 올리지 않음).

# dev API 주소: terraform -chdir=../infra/envs/dev output -raw api_endpoint
HAEBOM_API_URL=https://xxxxxxxx.execute-api.ap-northeast-2.amazonaws.com

# Firebase 웹 앱 설정 (Firebase 콘솔 → 프로젝트 설정 → 내 앱 → 웹). 공개 값이지만 저장소에는 넣지 않는다.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
